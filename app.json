
{
  "expo": {
    "name": "vovu",
    "slug": "vovu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "vovu",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vovu.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0d623b",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.vovu.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0d623b"
        }
      ]
    ]
  }
}
